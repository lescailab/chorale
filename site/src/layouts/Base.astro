---
import '../styles/global.css';
import 'katex/dist/katex.min.css';
const fm = Astro.props.frontmatter ?? {};
const title = Astro.props.title ?? fm.title ?? 'Documentation';
const description = Astro.props.description ?? fm.description ?? 'Integrating omics measured on different individuals.';
const toc = Astro.props.toc ?? fm.toc ?? true;
const wide = Astro.props.wide ?? fm.wide ?? false;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const here = Astro.url.pathname.replace(/\/$/, '') || base;
const nav = [
  ['Why', '/why'],
  ['How it works', '/how-it-works'],
  ['Tutorial', '/tutorial'],
  ['Outputs', '/outputs'],
  ['Methods', '/methods'],
];
// The function reference is generated by pkgdown and published beneath this site.
const referenceUrl = base + '/reference/';
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title} · CHORALE</title>
<meta name="description" content={description} />
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'><text y='13' font-size='14'>◇</text></svg>" />
<script is:inline>
  (() => {
    const s = localStorage.getItem('chorale-theme');
    if (s) document.documentElement.setAttribute('data-theme', s);
  })();
</script>
</head>
<body>
<header class="site">
  <div class="wrap row">
    <a class="brand" href={base + '/'}>CHO<span>RALE</span></a>
    <nav class="main">
      {nav.map(([label, href]) => (
        <a href={base + href} aria-current={here === base + href ? 'page' : undefined}>{label}</a>
      ))}
      <a href={referenceUrl}>Reference</a>
      <a href="https://github.com/lescailab/chorale">GitHub</a>
      <button class="tbtn" id="theme" type="button" aria-label="Switch between light and dark">◐</button>
    </nav>
  </div>
</header>

<main class="wrap">
  {toc ? (
    <div class="doc">
      <div class:list={['body', wide && 'wide']}><slot /></div>
      <aside class="toc"><p>On this page</p><nav id="toc"></nav></aside>
    </div>
  ) : (<slot />)}
</main>

<footer class="site">
  <div class="wrap">
    <p>
      CHORALE is developed at the Laboratory of Computational Genomics, University of Pavia.
      Source and issues on <a href="https://github.com/lescailab/chorale">GitHub</a>.
    </p>
    <p>Released under the MIT licence. Documentation built with Astro.</p>
  </div>
</footer>

<script is:inline>
  // theme
  const btn = document.getElementById('theme');
  btn?.addEventListener('click', () => {
    const dark = matchMedia('(prefers-color-scheme: dark)').matches;
    const cur = document.documentElement.getAttribute('data-theme') || (dark ? 'dark' : 'light');
    const next = cur === 'dark' ? 'light' : 'dark';
    document.documentElement.setAttribute('data-theme', next);
    localStorage.setItem('chorale-theme', next);
  });

  // table of contents, built from the headings actually present
  const holder = document.getElementById('toc');
  const body = document.querySelector('.doc .body');
  if (holder && body) {
    const hs = [...body.querySelectorAll('h2, h3')].filter(h => h.id);
    if (hs.length < 2) { holder.closest('aside')?.remove(); }
    else {
      hs.forEach(h => {
        const a = document.createElement('a');
        a.href = '#' + h.id;
        a.textContent = h.textContent;
        if (h.tagName === 'H3') a.className = 'lvl3';
        holder.appendChild(a);
      });
      const links = new Map([...holder.querySelectorAll('a')].map(a => [a.getAttribute('href').slice(1), a]));
      const seen = new Set();
      const spy = new IntersectionObserver(es => {
        es.forEach(e => e.isIntersecting ? seen.add(e.target.id) : seen.delete(e.target.id));
        links.forEach(a => a.classList.remove('active'));
        const first = hs.find(h => seen.has(h.id));
        if (first) links.get(first.id)?.classList.add('active');
      }, { rootMargin: '-72px 0px -70% 0px' });
      hs.forEach(h => spy.observe(h));
    }
  }

  // wrap tables so they scroll inside themselves
  document.querySelectorAll('main table').forEach(t => {
    if (t.parentElement?.classList.contains('tablewrap')) return;
    const w = document.createElement('div'); w.className = 'tablewrap';
    t.replaceWith(w); w.appendChild(t);
  });

  // reveal on scroll
  const io = new IntersectionObserver(es => es.forEach(e => {
    if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
  }), { rootMargin: '0px 0px -8% 0px' });
  document.querySelectorAll('.reveal').forEach(el => io.observe(el));
</script>
</body>
</html>
